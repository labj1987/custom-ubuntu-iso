diff --git a/plugins/rdp/rdp_relmouse.c b/plugins/rdp/rdp_relmouse.c
new file mode 100644
index 0000000..9961838
--- /dev/null
+++ b/plugins/rdp/rdp_relmouse.c
@@ -0,0 +1,281 @@
+/*
+ * Remmina - The GTK+ Remote Desktop Client
+ *
+ * Relative mouse input for games (see rdp_relmouse.h).
+ *
+ * This program is free software; you can redistribute it and/or modify it under the terms of the
+ * GNU General Public License as published by the Free Software Foundation; either version 2 of the
+ * License, or (at your option) any later version, with the OpenSSL exception of the rest of Remmina.
+ */
+
+#include "rdp_relmouse.h"
+#include "rdp_event.h"
+
+#include <math.h>
+
+#ifdef GDK_WINDOWING_WAYLAND
+#include <gdk/gdkwayland.h>
+#include "pointer-constraints-unstable-v1-client-protocol.h"
+#include "relative-pointer-unstable-v1-client-protocol.h"
+#endif
+
+struct remmina_rdp_relmouse {
+	RemminaProtocolWidget *gp;
+	gboolean remote_hidden;
+	gboolean focused;
+	gboolean active;
+	gboolean said;
+#ifdef GDK_WINDOWING_WAYLAND
+	struct wl_display *display;
+	struct zwp_relative_pointer_manager_v1 *relative_manager;
+	struct zwp_pointer_constraints_v1 *constraints;
+	struct zwp_relative_pointer_v1 *relative;
+	struct zwp_locked_pointer_v1 *locked;
+	/* Sub-unit motion carried to the next event, so slow movement is not lost to rounding. */
+	double rest_x, rest_y;
+#endif
+};
+
+static RemminaRdpRelMouse *get(RemminaProtocolWidget *gp)
+{
+	rfContext *rfi = GET_PLUGIN_DATA(gp);
+	return rfi ? rfi->relmouse : NULL;
+}
+
+#ifdef GDK_WINDOWING_WAYLAND
+
+static void push_motion(RemminaRdpRelMouse *rm, gint dx, gint dy)
+{
+	RemminaPluginRdpEvent rdp_event = { 0 };
+
+	rdp_event.type = REMMINA_RDP_EVENT_TYPE_MOUSE_REL;
+	rdp_event.mouse_rel_event.flags = PTR_FLAGS_MOVE;
+	rdp_event.mouse_rel_event.dx = (INT16)CLAMP(dx, G_MININT16, G_MAXINT16);
+	rdp_event.mouse_rel_event.dy = (INT16)CLAMP(dy, G_MININT16, G_MAXINT16);
+	remmina_rdp_event_event_push(rm->gp, &rdp_event);
+}
+
+static void relative_motion(void *data, struct zwp_relative_pointer_v1 *relative, uint32_t utime_hi, uint32_t utime_lo,
+			    wl_fixed_t dx, wl_fixed_t dy, wl_fixed_t dx_unaccel, wl_fixed_t dy_unaccel)
+{
+	RemminaRdpRelMouse *rm = data;
+
+	(void)relative; (void)utime_hi; (void)utime_lo; (void)dx; (void)dy;
+	if (!rm->active)
+		return;
+	/* The device's own motion, without the local desktop's acceleration: what a mouse plugged into
+	 * the server would report, and what the server's own pointer settings then apply to. */
+	rm->rest_x += wl_fixed_to_double(dx_unaccel);
+	rm->rest_y += wl_fixed_to_double(dy_unaccel);
+	gint ix = (gint)trunc(rm->rest_x);
+	gint iy = (gint)trunc(rm->rest_y);
+	if (ix == 0 && iy == 0)
+		return;
+	rm->rest_x -= ix;
+	rm->rest_y -= iy;
+	push_motion(rm, ix, iy);
+}
+
+static const struct zwp_relative_pointer_v1_listener relative_listener = {
+	.relative_motion = relative_motion,
+};
+
+static void registry_global(void *data, struct wl_registry *registry, uint32_t name, const char *interface, uint32_t version)
+{
+	RemminaRdpRelMouse *rm = data;
+
+	(void)version;
+	if (g_strcmp0(interface, zwp_relative_pointer_manager_v1_interface.name) == 0)
+		rm->relative_manager = wl_registry_bind(registry, name, &zwp_relative_pointer_manager_v1_interface, 1);
+	else if (g_strcmp0(interface, zwp_pointer_constraints_v1_interface.name) == 0)
+		rm->constraints = wl_registry_bind(registry, name, &zwp_pointer_constraints_v1_interface, 1);
+}
+
+static void registry_global_remove(void *data, struct wl_registry *registry, uint32_t name)
+{
+	(void)data; (void)registry; (void)name;
+}
+
+static const struct wl_registry_listener registry_listener = {
+	.global = registry_global,
+	.global_remove = registry_global_remove,
+};
+
+static void bind_globals(RemminaRdpRelMouse *rm)
+{
+	GdkDisplay *display = gdk_display_get_default();
+
+	if (!GDK_IS_WAYLAND_DISPLAY(display))
+		return;
+	rm->display = gdk_wayland_display_get_wl_display(display);
+	/* A private queue for the registry round trip, so GDK's own events are not dispatched from here. */
+	struct wl_event_queue *queue = wl_display_create_queue(rm->display);
+	struct wl_display *wrapped = wl_proxy_create_wrapper(rm->display);
+	wl_proxy_set_queue((struct wl_proxy *)wrapped, queue);
+	struct wl_registry *registry = wl_display_get_registry(wrapped);
+	wl_registry_add_listener(registry, &registry_listener, rm);
+	wl_display_roundtrip_queue(rm->display, queue);
+	wl_registry_destroy(registry);
+	wl_proxy_wrapper_destroy(wrapped);
+	/* The objects made from these go on GDK's default queue, which GTK's main loop dispatches. */
+	if (rm->relative_manager)
+		wl_proxy_set_queue((struct wl_proxy *)rm->relative_manager, NULL);
+	if (rm->constraints)
+		wl_proxy_set_queue((struct wl_proxy *)rm->constraints, NULL);
+	wl_event_queue_destroy(queue);
+}
+
+static gboolean lock_pointer(RemminaRdpRelMouse *rm)
+{
+	rfContext *rfi = GET_PLUGIN_DATA(rm->gp);
+	GdkDisplay *display = gdk_display_get_default();
+	GdkDevice *pointer = gdk_seat_get_pointer(gdk_display_get_default_seat(display));
+	GtkWidget *toplevel;
+	GdkWindow *window;
+	struct wl_pointer *wl_pointer;
+	struct wl_surface *surface;
+
+	if (!rfi || !rfi->drawing_area || !rm->relative_manager || !rm->constraints || !pointer)
+		return FALSE;
+	toplevel = gtk_widget_get_toplevel(rfi->drawing_area);
+	window = toplevel ? gtk_widget_get_window(toplevel) : NULL;
+	if (!window || !GDK_IS_WAYLAND_WINDOW(window))
+		return FALSE;
+	wl_pointer = gdk_wayland_device_get_wl_pointer(pointer);
+	surface = gdk_wayland_window_get_wl_surface(window);
+	if (!wl_pointer || !surface)
+		return FALSE;
+	rm->locked = zwp_pointer_constraints_v1_lock_pointer(rm->constraints, surface, wl_pointer, NULL,
+							     ZWP_POINTER_CONSTRAINTS_V1_LIFETIME_PERSISTENT);
+	rm->relative = zwp_relative_pointer_manager_v1_get_relative_pointer(rm->relative_manager, wl_pointer);
+	zwp_relative_pointer_v1_add_listener(rm->relative, &relative_listener, rm);
+	rm->rest_x = rm->rest_y = 0.0;
+	wl_display_flush(rm->display);
+	return TRUE;
+}
+
+static void unlock_pointer(RemminaRdpRelMouse *rm)
+{
+	if (rm->relative) {
+		zwp_relative_pointer_v1_destroy(rm->relative);
+		rm->relative = NULL;
+	}
+	if (rm->locked) {
+		zwp_locked_pointer_v1_destroy(rm->locked);
+		rm->locked = NULL;
+	}
+	if (rm->display)
+		wl_display_flush(rm->display);
+}
+
+#endif
+
+/* Relative mode is wanted while the remote cursor is hidden, the session has the focus, the server
+ * announced relative mouse input, and the profile has not turned it off. */
+static void update(RemminaRdpRelMouse *rm)
+{
+	rfContext *rfi = GET_PLUGIN_DATA(rm->gp);
+	RemminaFile *remminafile = remmina_plugin_service->protocol_plugin_get_file(rm->gp);
+	gboolean server = rfi && rfi->connected &&
+			  freerdp_settings_get_bool(rfi->clientContext.context.settings, FreeRDP_HasRelativeMouseEvent);
+	gboolean allowed = !remmina_plugin_service->file_get_int(remminafile, "disable-relative-mouse", FALSE) &&
+			   !remmina_plugin_service->file_get_int(remminafile, "viewonly", FALSE);
+	gboolean want = rm->remote_hidden && rm->focused && server && allowed;
+
+	if (want == rm->active)
+		return;
+#ifdef GDK_WINDOWING_WAYLAND
+	if (want) {
+		if (!lock_pointer(rm)) {
+			if (!rm->said) {
+				rm->said = TRUE;
+				g_message("[RDP] relative mouse: no Wayland pointer lock available; the mouse stays absolute");
+			}
+			unlock_pointer(rm);
+			return;
+		}
+		rm->active = TRUE;
+		REMMINA_PLUGIN_DEBUG("relative mouse on (remote cursor hidden)");
+	} else {
+		rm->active = FALSE;
+		unlock_pointer(rm);
+		REMMINA_PLUGIN_DEBUG("relative mouse off");
+	}
+#else
+	if (want && !rm->said) {
+		rm->said = TRUE;
+		g_message("[RDP] relative mouse: only supported on Wayland; the mouse stays absolute");
+	}
+#endif
+}
+
+void remmina_rdp_relmouse_init(RemminaProtocolWidget *gp)
+{
+	rfContext *rfi = GET_PLUGIN_DATA(gp);
+	RemminaRdpRelMouse *rm;
+
+	if (!rfi || rfi->relmouse)
+		return;
+	rm = g_new0(RemminaRdpRelMouse, 1);
+	rm->gp = gp;
+	rm->focused = TRUE;
+#ifdef GDK_WINDOWING_WAYLAND
+	bind_globals(rm);
+#endif
+	rfi->relmouse = rm;
+}
+
+void remmina_rdp_relmouse_free(RemminaProtocolWidget *gp)
+{
+	rfContext *rfi = GET_PLUGIN_DATA(gp);
+	RemminaRdpRelMouse *rm = rfi ? rfi->relmouse : NULL;
+
+	if (!rm)
+		return;
+#ifdef GDK_WINDOWING_WAYLAND
+	unlock_pointer(rm);
+	if (rm->relative_manager)
+		zwp_relative_pointer_manager_v1_destroy(rm->relative_manager);
+	if (rm->constraints)
+		zwp_pointer_constraints_v1_destroy(rm->constraints);
+	if (rm->display)
+		wl_display_flush(rm->display);
+#endif
+	rfi->relmouse = NULL;
+	g_free(rm);
+}
+
+void remmina_rdp_relmouse_set_remote_hidden(RemminaProtocolWidget *gp, gboolean hidden)
+{
+	RemminaRdpRelMouse *rm = get(gp);
+
+	if (!rm)
+		return;
+	rm->remote_hidden = hidden;
+	update(rm);
+}
+
+void remmina_rdp_relmouse_set_focus(RemminaProtocolWidget *gp, gboolean focused)
+{
+	RemminaRdpRelMouse *rm = get(gp);
+
+	if (!rm)
+		return;
+	rm->focused = focused;
+	update(rm);
+}
+
+void remmina_rdp_relmouse_poke(RemminaProtocolWidget *gp)
+{
+	RemminaRdpRelMouse *rm = get(gp);
+
+	if (rm && rm->remote_hidden && !rm->active)
+		update(rm);
+}
+
+gboolean remmina_rdp_relmouse_active(RemminaProtocolWidget *gp)
+{
+	RemminaRdpRelMouse *rm = get(gp);
+
+	return rm && rm->active;
+}
diff --git a/plugins/rdp/rdp_relmouse.h b/plugins/rdp/rdp_relmouse.h
new file mode 100644
index 0000000..9efc855
--- /dev/null
+++ b/plugins/rdp/rdp_relmouse.h
@@ -0,0 +1,33 @@
+/*
+ * Remmina - The GTK+ Remote Desktop Client
+ *
+ * Relative mouse input for games: while the remote cursor is hidden (a game captured the mouse) and
+ * the server accepts relative mouse events, the local pointer is locked to the window and its raw
+ * motion is sent as RDP relative mouse events (TS_FP_RELPOINTER_EVENT) instead of absolute positions.
+ * A game that keeps its pointer centred (most of them, under Wine/Xwayland: the server's pointer is
+ * locked) only ever sees relative motion, so absolute positions alone never reach it.
+ *
+ * Wayland only (zwp_pointer_constraints_v1 + zwp_relative_pointer_v1); elsewhere it stays off.
+ *
+ * This program is free software; you can redistribute it and/or modify it under the terms of the
+ * GNU General Public License as published by the Free Software Foundation; either version 2 of the
+ * License, or (at your option) any later version, with the OpenSSL exception of the rest of Remmina.
+ */
+
+#pragma once
+
+#include "rdp_plugin.h"
+
+typedef struct remmina_rdp_relmouse RemminaRdpRelMouse;
+
+/* Called on the GTK thread throughout. */
+void remmina_rdp_relmouse_init(RemminaProtocolWidget *gp);
